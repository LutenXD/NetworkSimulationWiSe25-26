attr seedset 23
itervar betaProducer 1.4s
config description "Parameter study: β_producer = 1s to 10s (0.1s steps), β_service = 1s, 5 repetitions"
config *.serviceUnit.meanServiceTime 1s
config *.producer.warmupPeriod 100s
config *.queue.warmupPeriod 100s
