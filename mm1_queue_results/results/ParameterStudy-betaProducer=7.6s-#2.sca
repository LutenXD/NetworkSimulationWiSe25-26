version 3
run ParameterStudy-332-20251130-20:04:00-476
attr configname ParameterStudy
attr datetime 20251130-20:04:00
attr datetimef 20251130-200400
attr experiment ParameterStudy
attr inifile omnetpp.ini
attr iterationvars $betaProducer=7.6s
attr iterationvarsd betaProducer=7.6s
attr iterationvarsf betaProducer=7.6s-
attr measurement $betaProducer=7.6s
attr network queue_sim
attr processid 476
attr repetition 2
attr replication #2
attr resultdir results
attr runnumber 332
attr seedset 332
itervar betaProducer 7.6s
config description "Parameter study: β_producer = 1s to 10s (0.1s steps), β_service = 1s, 5 repetitions"
config *.serviceUnit.meanServiceTime 1s
config *.producer.warmupPeriod 100s
config *.queue.warmupPeriod 100s
config *.serviceUnit.warmupPeriod 100s
config *.sink.warmupPeriod 100s
config *.producer.meanInterArrivalTime 7.6s
config network queue_sim
config sim-time-limit 600s
config warmup-period 100s
config repeat 5
config **.vector-recording true
config **.scalar-recording true
config debug-on-errors true

par queue_sim.producer typename "\"Producer\""
par queue_sim.producer meanInterArrivalTime 7.6s
attr unit s
par queue_sim.producer warmupPeriod 100s
attr unit s
