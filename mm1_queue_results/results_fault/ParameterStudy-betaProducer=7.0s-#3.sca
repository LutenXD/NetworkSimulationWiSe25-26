attr datetimef 20251130-200400
attr experiment ParameterStudy
attr inifile omnetpp.ini
attr iterationvars $betaProducer=7.0s
attr iterationvarsd betaProducer=7.0s
attr iterationvarsf betaProducer=7.0s-
attr measurement $betaProducer=7.0s
attr network queue_sim
