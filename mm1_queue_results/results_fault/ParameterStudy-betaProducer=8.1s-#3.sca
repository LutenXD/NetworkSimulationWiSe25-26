attr experiment ParameterStudy
attr inifile omnetpp.ini
attr iterationvars $betaProducer=8.1s
attr iterationvarsd betaProducer=8.1s
attr iterationvarsf betaProducer=8.1s-
attr measurement $betaProducer=8.1s
attr network queue_sim
attr processid 476
attr repetition 3
